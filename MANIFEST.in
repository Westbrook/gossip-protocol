# A source checkout/sdist can run the complete offline inventory. Scientific
# history, local secrets, environments and independent report state are excluded.
include README.md AGENTS.md VERIFICATION.md VERIFICATION_PLAN.md
include .gitignore
include pyproject.toml requirements-dev.lock verification-manifest.json
include *-study-plan.json
include *.html
include retain_experiments.py retain_swarm.py
recursive-include gossip_harness *.py
recursive-include tests *.py
recursive-include simulation *.py *.json
recursive-include analysis *.py *.json
recursive-include devtools *.py *.json *.cjs *.md
include scripts/bootstrap-dev
include .github/README.md .github/workflows/verification.yml
# This exact small historical fixture is a declared dependency, not a study dump.
include results/practical-live-1/accepted/single/README.md
include results/practical-live-1/accepted/single/SOURCE_COMMIT
include results/practical-live-1/accepted/single/task_report/__init__.py
include results/practical-live-1/accepted/single/task_report/__main__.py
include results/practical-live-1/accepted/single/task_report/cli.py
include results/practical-live-1/accepted/single/task_report/parser.py
include results/practical-live-1/accepted/single/task_report/summary.py
# Public cumulative contract and compatibility inputs used by acceptance checks.
include library-m1-acceptance-inventory-v1.json
include library-cumulative-product-v1.json library-cumulative-product-v2.json
include large-swarm-project-plan-v1.json
recursive-include docs *.md
include fixtures/library-m4-compatibility-v1/README.md
include fixtures/library-m4-compatibility-v1/build_snapshots.py
include fixtures/library-m4-compatibility-v1/v0.manifest.json
include fixtures/library-m4-compatibility-v1/v0.sqlite3
include fixtures/library-m4-compatibility-v1/m2.manifest.json
include fixtures/library-m4-compatibility-v1/m2.sqlite3
prune runs
prune .cache
prune .venv
prune .verification
exclude .progress-report/project.json
include .progress-report/project.example.json
prune devtools/browser/node_modules
global-exclude *.py[cod] .DS_Store .env .env.*
