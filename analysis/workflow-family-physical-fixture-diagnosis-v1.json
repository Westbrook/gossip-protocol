      "path": "library/clients/workflow.py",
      "sha256": "afd529ca9dcbd18560d225e71c812bab3c1e1c96b0b4396151f4cc8d8c9d532c",
      "source_excerpts": [
        {
          "line": 10,
          "text": "def solve(payload):"
        },
        {
          "line": 11,
          "text": "    with tempfile.TemporaryDirectory(prefix='research-library-') as directory:"
        },
        {
          "line": 12,
          "text": "        # This directory is created by the adapter, not a supplied intake path."
        },
        {
          "line": 13,
          "text": "        base = Path(directory).resolve()"
        },
        {
          "line": 14,
          "text": "        root = base / 'input'"
        },
        {
          "line": 15,
          "text": "        root.mkdir()"
        },
        {
          "line": 16,
          "text": "        path = base / 'library.sqlite3'"
        },
        {
          "line": 17,
          "text": "        store = Store(path)"
        },
        {
          "line": 18,
          "text": "        results = []"
        },
        {
          "line": 19,
          "text": "        try:"
        },
        {
          "line": 20,
          "text": "            for index, operation in enumerate(payload['operations']):"
        },
        {
          "line": 21,
          "text": "                service = Service(store, root)"
        },
        {
          "line": 22,
          "text": "                jobs = JobManager(store)"
        },
        {
          "line": 23,
          "text": "                try:"
        },
        {
          "line": 24,
          "text": "                    op = operation['op']"
        },
        {
          "line": 52,
          "text": "                    elif payload.get('milestone') == 'm1' and op == 'commit':"
        },
        {
          "line": 53,
          "text": "                        fail = operation.get('fail_before_commit', False)"
        },
        {
          "line": 54,
          "text": "                        result = jobs.commit({'job_id': operation['job_id'], 'epoch': operation['epoch']},"
        },
        {
          "line": 55,
          "text": "                                             fail_before_commit=fail)"
        },
        {
          "line": 56,
          "text": "                    else:"
        },
        {
          "line": 57,
          "text": "                        raise LibraryError('unsupported_operation')"
        },
        {
          "line": 58,
          "text": "                except LibraryError as error:"
        },
        {
          "line": 59,
          "text": "                    result = {'error': error.code}"
        },
        {
          "line": 60,
          "text": "                results.append(result)"
        },
        {
          "line": 61,
          "text": "            value = {'results': results, 'documents': store.documents()}"
        },
        {
          "line": 62,
          "text": "            if payload.get('milestone') == 'm1':"
        },
        {
          "line": 63,
          "text": "                value['jobs'] = store.list_jobs()"
        },
        {
          "line": 64,
          "text": "            return value"
        },
        {
          "line": 65,
          "text": "        finally:"
        },
        {
          "line": 66,
          "text": "            store.close()"
        }
      ]
    },
