  "justifications": {
    "posthoc-add-self-before-missing": {
      "contract": "Q1-add: Existing job ID => duplicate; self dependency => cycle; nonexistent dependency => missing, in that precedence after syntax validation.",
      "minimum_requirement_stage": 1,
      "reason": "The new job ID appears among otherwise syntactically valid dependencies, so cycle must take precedence regardless of dependency array order. No job or audit event is created."
    },
    "posthoc-batch-first-error-precedence": {
      "contract": "Q3-atomic: commands execute sequentially inside one transaction; first failed inner command returns its code and zero-based index, rolls back earlier writes, and skips later commands.",
      "minimum_requirement_stage": 3,
      "reason": "The batch envelope is valid. Inner command 0 duplicates an existing job, so it fails before inner command 1 is reached. The later prohibited audit is not a batch-envelope error and cannot replace the first error. The pre-batch job and its audit event remain."
    },
    "posthoc-finish-outcome-list-invalid": {
      "contract": "Common contract: malformed fields return invalid and leave state unchanged. Q2-fence: outcome is done, retry, or failed; syntactic validation comes before DB state checks.",
      "minimum_requirement_stage": 2,
      "reason": "A JSON array is none of the three permitted outcome strings. It must produce a typed invalid result, not a Python TypeError. The active claim and audit history remain unchanged."
    }
  },
